# Sao chép file này thành .env khi chạy trên máy. Trên Hostinger, nhập các biến này trong hPanel.

# Mật khẩu đăng nhập trang /admin — hãy đặt mật khẩu dài, khó đoán.
ADMIN_PASSWORD=

# Chuỗi ngẫu nhiên dài để ký cookie phiên đăng nhập (tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=

# Thư mục lưu dữ liệu JSON + ảnh tải lên. Trên Hostinger nên đặt NGOÀI thư mục ứng dụng, ví dụ /home/uXXXXXXX/phuc-data
DATA_DIR=

# production khi chạy thật
NODE_ENV=development
